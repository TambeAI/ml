

import pandas as pd
import matplotlib.pyplot as plt

# ==========================================================
# 1. LOAD DATASET
# ==========================================================

df = pd.read_csv("city_day.csv")

print("First 5 Records:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

print("\nColumn Names:")
print(df.columns.tolist())

print("\nDataset Information:")
df.info()

print("\nMissing Values:")
print(df.isnull().sum())


# ==========================================================
# 2. DATE CONVERSION
# ==========================================================

df["Date"] = pd.to_datetime(
    df["Date"],
    format="%Y-%m-%d"
)

print("\nDate Converted Successfully!")


# ==========================================================
# 3. SUMMARY STATISTICS
# ==========================================================

print("\nSummary Statistics:")
print(df.describe())


# ==========================================================
# 4. AQI TREND OVER TIME
# ==========================================================

plt.figure(figsize=(10, 5))

plt.plot(
    df["Date"],
    df["AQI"],
    marker="o"
)

plt.title("AQI Trend Over Time")
plt.xlabel("Date")
plt.ylabel("AQI")

plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.show()


# ==========================================================
# 5. POLLUTANT LEVELS OVER TIME
# ==========================================================

plt.figure(figsize=(10, 5))

plt.plot(df["Date"], df["PM2.5"], label="PM2.5")
plt.plot(df["Date"], df["PM10"], label="PM10")
plt.plot(df["Date"], df["CO"], label="CO")

plt.title("Pollutant Levels Over Time")
plt.xlabel("Date")
plt.ylabel("Pollutant Level")

plt.legend()
plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.show()


# ==========================================================
# 6. AQI COMPARISON BY DATE
# ==========================================================

plt.figure(figsize=(10, 5))

plt.bar(df["Date"], df["AQI"])

plt.title("AQI Comparison by Date")
plt.xlabel("Date")
plt.ylabel("AQI")

plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


# ==========================================================
# 7. AQI DISTRIBUTION USING BOXPLOT
# ==========================================================

plt.figure(figsize=(7, 5))

plt.boxplot(df["AQI"].dropna())

plt.title("AQI Distribution")
plt.ylabel("AQI")

plt.show()


# ==========================================================
# 8. PM2.5 VS AQI
# ==========================================================

plt.figure(figsize=(8, 5))

plt.scatter(df["PM2.5"], df["AQI"])

plt.title("PM2.5 vs AQI")
plt.xlabel("PM2.5")
plt.ylabel("AQI")

plt.grid(True)
plt.show()


# ==========================================================
# 9. PM10 VS AQI
# ==========================================================

plt.figure(figsize=(8, 5))

plt.scatter(df["PM10"], df["AQI"])

plt.title("PM10 vs AQI")
plt.xlabel("PM10")
plt.ylabel("AQI")

plt.grid(True)
plt.show()


# ==========================================================
# 10. CO VS AQI
# ==========================================================

plt.figure(figsize=(8, 5))

plt.scatter(df["CO"], df["AQI"])

plt.title("CO vs AQI")
plt.xlabel("CO")
plt.ylabel("AQI")

plt.grid(True)
plt.show()
